# Salin file ini menjadi .env lalu isi nilainya. File .env TIDAK di-commit (ada di .gitignore).

# OpenRouter: LLM dan embedding (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=openai/text-embedding-3-small

# Qdrant Cloud (https://cloud.qdrant.io)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=imdb_movies

# Langfuse Cloud, region EU (https://cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
